trainer(102, amit, strength).
trainer(103, sneha, yoga).
trainer(104, pratik, crossfit).
trainer(105, pooja, zumba).

member(1, ayush).
member(2, rohan).
member(3, sneha).
member(4, pratik).
member(5, pooja).

booking(1, 101).
booking(2, 102).
booking(3, 103).
booking(5, 105).

