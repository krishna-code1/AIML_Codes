fee(103, 400).
fee(104, 600).
fee(105, 450).

booked(MemberName, TrainerName) :-
    member(MID, MemberName),
    booking(MID, TrainerID),
    trainer(TrainerID, TrainerName, _).

training(TrainerName, TrainingType) :-
    trainer(_, TrainerName, TrainingType).

has_booking(MemberName) :-
    member(MID, MemberName),
    booking(MID, _).

booking_fee(MemberName, Fee) :-
    member(MID, MemberName),
    booking(MID, TrainerID),
    fee(TrainerID, Fee).

available_trainer(TrainingType, TrainerName) :-
    trainer(_, TrainerName, TrainingType).

trainer_for(MemberName, TrainerName) :-
    booked(MemberName, TrainerName).

unbooked(MemberName) :-
    member(_, MemberName),
    \+ has_booking(MemberName).
